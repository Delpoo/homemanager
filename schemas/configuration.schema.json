{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persistent configuration V2",
  "description": "Authenticated persistent configuration. Runtime HA state, command acknowledgements and session credentials are excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rooms",
    "catalog",
    "architecture",
    "actions",
    "panels",
    "stateSources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "rooms": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/room"
      },
      "$comment": "Ordered instance spaces (navigation order). Unique IDs and device roomId membership are semantic rules."
    },
    "catalog": {
      "allOf": [
        {
          "$ref": "catalog.schema.json"
        },
        {
          "properties": {
            "devices": {
              "items": {
                "properties": {
                  "state": {
                    "properties": {
                      "value": {
                        "const": "unknown"
                      },
                      "confidence": {
                        "const": "unknown"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "content"
      ],
      "properties": {
        "format": {
          "const": "svg"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        }
      },
      "$comment": "The content must pass the SVG sanitizer before persistence and before rendering. The application additionally enforces a 1 MiB UTF-8 byte limit; maxLength alone counts characters."
    },
    "actions": {
      "type": "object",
      "maxProperties": 2000,
      "propertyNames": {
        "$ref": "#/$defs/mapKey"
      },
      "additionalProperties": {
        "$ref": "#/$defs/action"
      }
    },
    "panels": {
      "type": "object",
      "maxProperties": 2000,
      "propertyNames": {
        "$ref": "#/$defs/mapKey"
      },
      "additionalProperties": {
        "$ref": "#/$defs/panel"
      }
    },
    "stateSources": {
      "type": "object",
      "maxProperties": 2000,
      "propertyNames": {
        "$ref": "#/$defs/mapKey"
      },
      "additionalProperties": {
        "$ref": "#/$defs/stateSource"
      }
    },
    "commandTtlSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300,
      "default": 30
    },
    "rules": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "enabled",
          "sources",
          "symbols",
          "level"
        ],
        "properties": {
          "id": {
            "$ref": "catalog.schema.json#/$defs/deviceId"
          },
          "name": {
            "$ref": "catalog.schema.json#/$defs/text"
          },
          "enabled": {
            "type": "boolean"
          },
          "level": {
            "enum": [
              "alert",
              "warning",
              "indicator"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reading"
              ],
              "properties": {
                "reading": {
                  "allOf": [
                    {
                      "$ref": "catalog.schema.json#/$defs/entityId"
                    },
                    {
                      "pattern": "^(sensor|binary_sensor)\\."
                    }
                  ]
                },
                "deviceId": {
                  "$ref": "catalog.schema.json#/$defs/registryDeviceId"
                }
              }
            }
          },
          "symbols": {
            "type": "array",
            "maxItems": 2000,
            "uniqueItems": true,
            "items": {
              "$ref": "catalog.schema.json#/$defs/deviceId"
            }
          },
          "below": {
            "type": "number"
          },
          "above": {
            "type": "number"
          },
          "forMinutes": {
            "type": "number",
            "minimum": 0
          },
          "state": {
            "enum": [
              "on",
              "off"
            ]
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "badge": {
            "type": "boolean"
          },
          "highlight": {
            "type": "boolean"
          },
          "bar": {
            "type": "boolean"
          },
          "now": {
            "type": "boolean"
          }
        }
      },
      "$comment": "Semantic checks require unique rule/source IDs and homogeneous binary or numeric conditions."
    },
    "planWidthMetres": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 10000,
      "$comment": "0.13: the real width of the plan drawing, for measures in metres and areas in m²."
    },
    "pinnedAutomations": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "$comment": "0.13: HomeManager automations with a button in Now. The automations live in Home Assistant.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "icon"],
        "properties": {
          "id": { "type": "string", "pattern": "^homemanager_[a-z0-9_]{1,52}$" },
          "icon": { "$ref": "catalog.schema.json#/$defs/mdiIcon" }
        }
      }
    },
    "planViews": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "anyOf": [
          {
            "required": [
              "light"
            ],
            "properties": {
              "light": {}
            }
          },
          {
            "required": [
              "dark"
            ],
            "properties": {
              "dark": {}
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          },
          "light": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "sha256",
              "format",
              "box"
            ],
            "properties": {
              "scope": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "format": {
                "enum": [
                  "svg",
                  "png",
                  "jpg"
                ]
              },
              "box": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -10000000,
                    "maximum": 10000000
                  },
                  {
                    "type": "number",
                    "minimum": -10000000,
                    "maximum": 10000000
                  },
                  {
                    "type": "number",
                    "minimum": -10000000,
                    "maximum": 10000000,
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "number",
                    "minimum": -10000000,
                    "maximum": 10000000,
                    "exclusiveMinimum": 0
                  }
                ],
                "items": false
              }
            }
          },
          "dark": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "sha256",
              "format",
              "box"
            ],
            "properties": {
              "scope": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "format": {
                "enum": [
                  "svg",
                  "png",
                  "jpg"
                ]
              },
              "box": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -10000000,
                    "maximum": 10000000
                  },
                  {
                    "type": "number",
                    "minimum": -10000000,
                    "maximum": 10000000
                  },
                  {
                    "type": "number",
                    "minimum": -10000000,
                    "maximum": 10000000,
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "number",
                    "minimum": -10000000,
                    "maximum": 10000000,
                    "exclusiveMinimum": 0
                  }
                ],
                "items": false
              }
            }
          },
          "lightBackground": {
            "type": "string",
            "pattern": "^(#[0-9a-fA-F]{6}|transparent)$"
          },
          "darkBackground": {
            "type": "string",
            "pattern": "^(#[0-9a-fA-F]{6}|transparent)$"
          }
        }
      }
    },
    "nowPanels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 240,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "type": {
                "enum": [
                  "alerts",
                  "climate",
                  "reading",
                  "readings",
                  "active",
                  "energy",
                  "control",
                  "shortcut"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "\\S"
              },
              "devices": {
                "type": "array",
                "maxItems": 2000,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 240,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "readings": {
                "type": "array",
                "maxItems": 200,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 240,
                  "pattern": "^(?!.*\\.all$)[a-z][a-z0-9_]*\\.[a-z0-9_]+$"
                }
              },
              "deviceId": {
                "type": "string",
                "maxLength": 240,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "roomId": {
                "type": "string",
                "maxLength": 240,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "controlId": {
                "type": "string",
                "maxLength": 240,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          }
        },
        "wall": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 240,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "type": {
                "enum": [
                  "alerts",
                  "climate",
                  "reading",
                  "readings",
                  "active",
                  "energy",
                  "control",
                  "shortcut"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "\\S"
              },
              "devices": {
                "type": "array",
                "maxItems": 2000,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 240,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "readings": {
                "type": "array",
                "maxItems": 200,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 240,
                  "pattern": "^(?!.*\\.all$)[a-z][a-z0-9_]*\\.[a-z0-9_]+$"
                }
              },
              "deviceId": {
                "type": "string",
                "maxLength": 240,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "roomId": {
                "type": "string",
                "maxLength": 240,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "controlId": {
                "type": "string",
                "maxLength": 240,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          }
        }
      }
    },
    "symbolSizes": {
      "$comment": "Plan 0.12 #94: symbol size for the whole house and the per-space view, and its limits.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "house",
        "room",
        "min",
        "max"
      ],
      "properties": {
        "house": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2.5
        },
        "room": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2.5
        },
        "min": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2.5
        },
        "max": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2.5
        }
      }
    },
    "initialView": {
      "$comment": "Plan 0.12 #94: the view the plan opens with.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "room",
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "room": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "x": {
          "type": "number",
          "minimum": -1,
          "maximum": 2
        },
        "y": {
          "type": "number",
          "minimum": -1,
          "maximum": 2
        },
        "zoom": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 16
        },
        "planView": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "baseRules": {
      "$comment": "Plan 0.12 #60: switches and limits of the automatic rules; absent means battery below 15 %, offline 10 minutes, safety on.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "battery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "below": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "unavailable": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minutes": {
              "type": "number",
              "minimum": 1,
              "maximum": 1440
            }
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "$comment": "A rectangle normalized to the plan. x + width and y + height stay within 1 (semantic rule)."
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "catalog.schema.json#/$defs/roomId"
        },
        "label": {
          "$ref": "catalog.schema.json#/$defs/text"
        },
        "icon": {
          "$ref": "catalog.schema.json#/$defs/mdiIcon",
          "$comment": "Optional MDI icon for the space rail."
        },
        "shape": {
          "$ref": "#/$defs/rect",
          "$comment": "D22: the space's own rectangle; with rects, the box around them."
        },
        "rects": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/rect"
          },
          "$comment": "A zone of merged rectangles: an L is two."
        },
        "outline": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 200,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "$comment": "0.13: the space's own outline with straight sides, outer ring first, then holes; shares of the plan. Requires shapeSource app and no rects."
        },
        "shapeSource": {
          "enum": [
            "svg",
            "app"
          ],
          "$comment": "svg: copied from a zone; app: edited in HomeManager, never overwritten. Requires shape."
        },
        "areaId": {
          "$ref": "catalog.schema.json#/$defs/text",
          "$comment": "The Home Assistant area this space stands for (stage 5 of 0.10)."
        },
        "frame": {
          "enum": [
            "tight",
            "normal",
            "wide"
          ],
          "$comment": "Room view framing around the space; normal when absent."
        },
        "nav": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skip": {
              "type": "boolean",
              "$comment": "A space you pass through: it gets no arrows and no swipes."
            },
            "hidden": {
              "type": "array",
              "maxItems": 200,
              "uniqueItems": true,
              "items": {
                "$ref": "catalog.schema.json#/$defs/roomId"
              },
              "$comment": "Destinations without an arrow from this space."
            }
          }
        }
      },
      "dependentRequired": {
        "shapeSource": [
          "shape"
        ],
        "rects": [
          "shape"
        ],
        "outline": [
          "shape",
          "shapeSource"
        ]
      },
      "dependentSchemas": {
        "outline": {
          "properties": {
            "shapeSource": {
              "const": "app"
            },
            "rects": false
          }
        }
      }
    },
    "mapKey": {
      "allOf": [
        {
          "$ref": "catalog.schema.json#/$defs/deviceId"
        },
        {
          "not": {
            "enum": [
              "__proto__",
              "prototype",
              "constructor"
            ]
          }
        }
      ]
    },
    "entityId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 240,
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$"
    },
    "dataKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "not": {
        "anyOf": [
          {
            "enum": [
              "__proto__",
              "prototype",
              "constructor",
              "entity_id",
              "device_id",
              "area_id"
            ]
          },
          {
            "pattern": "^(?:[Rr][Ff]_[Cc][Oo][Dd][Ee][Ss]?|[Ii][Rr]_[Cc][Oo][Dd][Ee][Ss]?|[Cc][Oo][Dd][Ee][Ss]?|[Pp][Rr][Oo][Tt][Oo][Cc][Oo][Ll]|[Pp][Uu][Ll][Ss][Ee]_[Ll][Ee][Nn][Gg][Tt][Hh]|[Rr][Aa][Ww](?:_[Dd][Aa][Tt][Aa])?|[Rr][Cc]_[Ss][Ww][Ii][Tt][Cc][Hh]|[Cc][Oo][Mm][Mm][Aa][Nn][Dd][Ss]?|[Cc][Oo][Mm][Mm][Aa][Nn][Dd]_[Tt][Yy][Pp][Ee])$"
          }
        ]
      }
    },
    "jsonData": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 1024
        },
        {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/jsonData"
          }
        },
        {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "$ref": "#/$defs/dataKey"
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonData"
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "service",
        "target"
      ],
      "properties": {
        "domain": {
          "enum": [
            "light",
            "fan",
            "cover",
            "climate",
            "switch",
            "button",
            "script",
            "scene",
            "vacuum",
            "select",
            "input_button"
          ]
        },
        "service": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entity_id"
          ],
          "properties": {
            "entity_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/entityId"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/entityId"
                  }
                }
              ]
            }
          }
        },
        "data": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "$ref": "#/$defs/dataKey"
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonData"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "domain": {
                "const": "light"
              }
            }
          },
          "then": {
            "properties": {
              "service": {
                "enum": [
                  "turn_on",
                  "turn_off",
                  "toggle"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": {
                "const": "fan"
              }
            }
          },
          "then": {
            "properties": {
              "service": {
                "enum": [
                  "turn_on",
                  "turn_off",
                  "toggle",
                  "set_percentage",
                  "set_preset_mode",
                  "set_direction",
